rules_version = '2';
// Clients never touch Firestore directly — the app talks only to the
// registerSchedule HTTPS function, which writes via the Admin SDK (and bypasses
// these rules). So deny all direct client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
